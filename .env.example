# ============================================================
# CHUNG CHO CẢ 2 SERVICE (nhưng giá trị khác nhau ở từng service)
# ============================================================

# "mia" hoặc "mie" — chọn persona nào chạy trên service này
PERSONA=mia

DISCORD_TOKEN=
CLIENT_ID=
CKEY_API_KEY=

# ============================================================
# STORAGE RIÊNG THEO PERSONA (mặc định tự sinh theo PERSONA nếu để trống)
# ============================================================
# MEMORY_FILE=./memory-mia.json
# USAGE_FILE=./usage-mia.json
# FAMILY_MEMORY_FILE=./family-context-mia.json

# Số tin nhắn gần nhất giữ lại trong memory của mỗi user (mặc định 20, chỉnh tuỳ ý)
MEMORY_HISTORY_LIMIT=20

# ============================================================
# GIAO TIẾP NỘI BỘ MIA <-> MIE
# ============================================================
# Bên service Mia: set MIE_INTERNAL_URL trỏ tới service Mie
# Bên service Mie: set MIA_INTERNAL_URL trỏ tới service Mia
MIE_INTERNAL_URL=
MIA_INTERNAL_URL=

# Secret dùng chung để 2 service xác thực nội bộ với nhau (đặt giống nhau ở cả 2 service)
INTERNAL_SECRET=

# Railway tự cấp PORT, không cần set thủ công khi deploy
# PORT=3000

# ============================================================
# TỰ ĐỘNG TRÒ CHUYỆN GIỮA MIA & MIE
# ============================================================
AUTO_CHAT_ENABLED=false
AUTO_CHAT_INTERVAL=1800000
MAX_CONVERSATION_TURNS=10

# Nếu để trống -> chế độ INTERNAL (không đăng lên Discord)
# Nếu set -> chế độ PUBLIC (mỗi bot tự đăng lượt nói của mình lên channel này)
FAMILY_CHAT_CHANNEL_ID=

# Tuỳ chọn nâng cao
# FAMILY_CHAT_COOLDOWN_MS=1800000
# FAMILY_TURN_DELAY_MS=3000
# INTERNAL_REQUEST_TIMEOUT_MS=15000

# ============================================================
# DEBUG
# ============================================================
# DEBUG=false
# DEBUG_GUILD=
